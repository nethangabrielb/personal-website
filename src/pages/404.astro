---
import { SITE } from "@/data/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title={`Not found — ${SITE.name}`}
  description="The requested page could not be found."
  canonicalPath="/404"
>
  <section class="w-full max-w-[1080px] mx-auto px-6 sm:px-10 pt-14 sm:pt-18">
    <h1 class="m-0 text-[1.5rem] sm:text-[1.625rem] font-medium leading-[1.2] tracking-[-0.025em] text-ink">
      Page not found
    </h1>
    <p class="mt-3 mb-0 max-w-[54ch] text-ink-secondary">
      The page you requested does not exist at this address.
    </p>
    <p class="mt-6 mb-0 text-[0.875rem]">
      <a href="/" class="inline-link">&larr; Back to index</a>
    </p>
  </section>
</BaseLayout>
